@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-column align-items-center justify-content-center text-center"
     style="min-height: 60vh;">
    <i class="bi bi-speedometer2" style="font-size: 4rem; opacity: .35;"></i>
    <h2 class="mt-3 mb-2">Dashboard в разработке</h2>
    <p class="text-secondary mb-4" style="max-width: 32rem;">
        Страница ещё готовится. Пока пользуйтесь готовыми разделами.
    </p>
    <div class="d-flex gap-2 flex-wrap justify-content-center">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-house-fill"></i> Обзор системы
        </a>
        <a asp-controller="Chart" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-graph-up"></i> График
        </a>
        <a asp-controller="DataQuality" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-clipboard2-check"></i> Data Quality
        </a>
    </div>
</div>
