<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BinanceDataCollector.DataManager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BinanceDataCollector.DataManager.styles.css" asp-append-version="true" />
    
<style>
        body {
            margin: 0;
            background-color: #f5f5f7;
        }

        .icon-sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 50px;
            height: 100vh;
            background: linear-gradient(180deg, #2d2d2d 0%, #1e1e1e 100%);
            box-shadow: 2px 0 8px rgba(0, 0, 0, 0.2);
            z-index: 1001;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 10px 0;
        }

        .icon-sidebar-item {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ababab;
            font-size: 20px;
            cursor: pointer;
            border-radius: 6px;
            margin: 4px 0;
            transition: all 0.2s;
            position: relative;
            text-decoration: none;
        }

        .icon-sidebar-item:hover {
            background-color: rgba(255, 255, 255, 0.1);
            color: #ffffff;
        }

        .icon-sidebar-item.active {
            background-color: #007AFF;
            color: white;
        }

        .icon-sidebar-divider {
            width: 30px;
            height: 1px;
            background-color: rgba(255, 255, 255, 0.2);
            margin: 8px 0;
        }

        .slide-menu {
            position: fixed;
            left: 50px;
            top: 0;
            width: 250px;
            height: 100vh;
            background-color: #ffffff;
            box-shadow: 2px 0 12px rgba(0, 0, 0, 0.15);
            z-index: 1000;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
            overflow-y: auto;
        }

        .slide-menu.open {
            transform: translateX(0);
        }

        .slide-menu-header {
            padding: 20px;
            border-bottom: 1px solid #e0e0e0;
        }

        .slide-menu-body {
            padding: 10px;
        }

        .menu-item {
            padding: 12px 16px;
            border-radius: 8px;
            margin: 4px 0;
            color: #1d1d1f;
            text-decoration: none;
            display: flex;
            align-items: center;
            font-weight: 500;
            font-size: 14px;
        }

        .menu-item:hover {
            background-color: #f0f0f5;
            color: #007AFF;
        }

        .menu-item.active {
            background-color: #007AFF;
            color: white;
        }

        .menu-item i {
            width: 24px;
            margin-right: 12px;
        }

        .menu-overlay {
            position: fixed;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.3);
            z-index: 999;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s;
        }

        .menu-overlay.show {
            opacity: 1;
            visibility: visible;
        }

        .main-content {
            margin-left: 50px;
            padding: 20px;
            min-height: 100vh;
        }

        .icon-sidebar-item::after {
            content: attr(data-tooltip);
            position: absolute;
            left: 55px;
            background-color: #2d2d2d;
            color: white;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s;
        }

        .icon-sidebar-item:hover::after {
            opacity: 1;
        }
    </style>
</head>
<body>
    <!-- Тонкая боковая панель -->
    <div class="icon-sidebar">
        <a asp-controller="Home" asp-action="Index" class="icon-sidebar-item" data-tooltip="Home" onclick="toggleIconActive(this)"><i class="bi bi-house-fill"></i></a>
        <a asp-controller="Home" asp-action="Dashboard" class="icon-sidebar-item" data-tooltip="Dashboard" onclick="toggleIconActive(this)"><i class="bi bi-speedometer2"></i></a>
        <a asp-controller="Archive" asp-action="Index" class="icon-sidebar-item" data-tooltip="Archives" onclick="toggleIconActive(this)"><i class="bi bi-archive-fill"></i></a>
        <a asp-controller="Inspector" asp-action="Index" class="icon-sidebar-item" data-tooltip="Inspector" onclick="toggleIconActive(this)"><i class="bi bi-search"></i></a>
        <a asp-controller="Chart" asp-action="Index" class="icon-sidebar-item" data-tooltip="Chart" onclick="toggleIconActive(this)"><i class="bi bi-graph-up"></i></a>
        <a asp-controller="DataQuality" asp-action="Index" class="icon-sidebar-item" data-tooltip="Data Quality" onclick="toggleIconActive(this)"><i class="bi bi-clipboard2-check"></i></a>
        <div class="icon-sidebar-divider"></div>
        <div class="icon-sidebar-item" data-tooltip="Menu" onclick="toggleMenu()">
            <i class="bi bi-list"></i>
        </div>
        <div style="flex-grow: 1;"></div>
        <a asp-controller="Home" asp-action="Privacy" class="icon-sidebar-item" data-tooltip="Privacy" onclick="toggleIconActive(this)"><i class="bi bi-shield-lock"></i></a>
    </div>

    <!-- Overlay -->
    <div class="menu-overlay" id="menuOverlay" onclick="closeMenu()"></div>

    <!-- Выдвижное меню -->
    <div class="slide-menu" id="slideMenu">
        <div class="slide-menu-header">
            <h5 class="mb-0">DataManager</h5>
            @if (User.Identity?.IsAuthenticated == true)
            {
                var displayName = User.FindFirst("name")?.Value
                                  ?? User.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name")?.Value
                                  ?? User.FindFirst("emails")?.Value
                                  ?? User.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")?.Value
                                  ?? User.Identity.Name
                                  ?? "Authenticated user";
                var roleText = string.Join(", ", User.Claims
                    .Where(claim => claim.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role")
                    .Select(claim => claim.Value)
                    .Distinct());
                if (string.IsNullOrWhiteSpace(roleText))
                {
                    roleText = "none";
                }
                <div class="small text-muted mt-2">@displayName</div>
                <div class="small text-muted">Role: @roleText</div>
            }
        </div>
        <div class="slide-menu-body">
            <a asp-controller="Home" asp-action="Index" class="menu-item"><i class="bi bi-house-fill"></i>Home</a>
            <a asp-controller="Home" asp-action="Dashboard" class="menu-item"><i class="bi bi-speedometer2"></i>Dashboard</a>
            <a asp-controller="Archive" asp-action="Index" class="menu-item"><i class="bi bi-archive-fill"></i>Archives</a>
            <a asp-controller="Inspector" asp-action="Index" class="menu-item"><i class="bi bi-search"></i>Inspector</a>
            <a asp-controller="Chart" asp-action="Index" class="menu-item"><i class="bi bi-graph-up"></i>Chart</a>
            <a asp-controller="DataQuality" asp-action="Index" class="menu-item"><i class="bi bi-clipboard2-check"></i>Data Quality</a>
            <hr class="my-3">
            <a asp-controller="Home" asp-action="Privacy" class="menu-item"><i class="bi bi-shield-lock"></i>Privacy</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="menu-item border-0 bg-transparent w-100 text-start">
                        <i class="bi bi-box-arrow-right"></i>Logout
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Контент -->
    <div class="main-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleMenu() {
            const menu = document.getElementById('slideMenu');
            const overlay = document.getElementById('menuOverlay');
            
            if (menu.classList.contains('open')) {
                closeMenu();
            } else {
                menu.classList.add('open');
                overlay.classList.add('show');
            }
        }

        function closeMenu() {
            document.getElementById('slideMenu').classList.remove('open');
            document.getElementById('menuOverlay').classList.remove('show');
        }

        function toggleIconActive(element) {
            document.querySelectorAll('.icon-sidebar-item').forEach(i => i.classList.remove('active'));
            element.classList.add('active');
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeMenu();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>