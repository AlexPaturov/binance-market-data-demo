<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<CodePage>65001</CodePage>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	  <UserSecretsId>aeaffe6b-9832-4794-b887-271e7541c4b6</UserSecretsId>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="8.0.0" />
		<PackageReference Include="AspNetCore.HealthChecks.Rabbitmq" Version="8.0.0" />
		<PackageReference Include="Dapper" Version="2.1.66" />
		<PackageReference Include="Hangfire.AspNetCore" Version="1.8.21" />
		<PackageReference Include="Hangfire.Core" Version="1.8.21" />
		<PackageReference Include="Hangfire.PostgreSql" Version="1.20.12" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.22" />
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.1" />
		<PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.15.0" />
		<PackageReference Include="Npgsql" Version="9.0.3" />
		<PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
		<PackageReference Include="Serilog" Version="4.3.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
		<PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
		<PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
		<PackageReference Include="Serilog.Enrichers.WithCaller" Version="1.3.0" />
		<PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
		<PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.Seq" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BinanceDataCollector.Infrastructure\BinanceDataCollector.Infrastructure.csproj" />
		<ProjectReference Include="..\BinanceDataCollector.Worker\BinanceDataCollector.Worker.csproj" />
	</ItemGroup>

	<ItemGroup>
        <!-- Не копировать appsettings из других проектов -->
        <Content Remove="../**/appsettings*.json" />
        <Content Include="appsettings.Development.json" />

        <!-- Но оставить свой -->
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <!-- Development конфиг не нужен в Production -->
        <Content Update="appsettings.Development.json">
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </Content>
	</ItemGroup>

    <!--
        Проект ссылается на Worker (нужен для Hangfire Enqueue<IArchiveDownloaderWorker> и т.п.),
        поэтому Worker.appsettings.json транзитивно попадает в publish DataManager и конфликтует
        с собственным appsettings.json (NETSDK1152). Убираем именно транзитивный файл из Worker,
        оставляя appsettings.json самого DataManager.
    -->
    <Target Name="_RemoveReferencedAppSettingsFromPublish"
            AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <ResolvedFileToPublish
                Remove="@(ResolvedFileToPublish)"
                Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.json' And $([System.String]::Copy('%(ResolvedFileToPublish.Identity)').Contains('BinanceDataCollector.Worker'))" />
        </ItemGroup>
    </Target>

</Project>
