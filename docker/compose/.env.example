# Шаблон окружения для локального стека (dev / demo).
# Скопируй в `.env` рядом и при необходимости поменяй значения:
#   cp .env.example .env
# Реальный `.env` в .gitignore и в репозиторий не попадает.
# Значения ниже — рабочие для локальной песочницы, не для прода.

# PostgreSQL: пользователь схемы; тот же логин ждут init-скрипты и pgbouncer.
POSTGRES_USER=bindatacoll
POSTGRES_PASSWORD=change_me_local

# Seq (просмотр логов): учётка администратора первого запуска.
SEQ_ADMIN_USER=admin
SEQ_ADMIN_PASS=change_me_local
SERILOG_SEQ_URL=http://bdc_seq:5341

# RabbitMQ: учётка и адрес брокера внутри compose-сети.
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_HOSTNAME=bdc_rabbitmq
