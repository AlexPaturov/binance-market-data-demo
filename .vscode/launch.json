{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch DataManager",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-datamanager", // Задача сборки перед запуском
            "program": "${workspaceFolder}/src/BinanceDataCollector.DataManager/bin/Debug/net8.0/BinanceDataCollector.DataManager.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/BinanceDataCollector.DataManager",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "Launch Worker",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-worker",
            "program": "${workspaceFolder}/src/BinanceDataCollector.Worker/bin/Debug/net8.0/BinanceDataCollector.Worker.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/BinanceDataCollector.Worker",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ],
    "compounds": [
        {
            "name": "Launch All (Worker + DataManager)",
            "configurations": [
                "Launch DataManager",
                "Launch Worker"
            ],
            // Опционально: можно добавить запуск docker-compose перед этим
            // "preLaunchTask": "docker-compose-up" 
        }
    ]
}