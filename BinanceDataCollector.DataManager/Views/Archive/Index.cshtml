@model ArchiveManagementViewModel
@{
    ViewData["Title"] = "Archive Management";
    var symbols = Model.ActiveSymbols;
}

<div class="row">
    <!-- Левая колонка: Форма для скачивания -->
    <div class="col-md-4">
        <form id="download-form">
            @Html.AntiForgeryToken()
            <div class="card shadow-sm border-0 mb-1" style="border-radius: 12px; overflow: hidden;">
                <div class="list-group list-group-flush">
                    <div class="list-group-item border-0 p-3">
                        <div class="d-flex align-items-end gap-3 flex-wrap flex-md-nowrap">
                            <div class="flex-fill" style="min-width: 200px;">
                                <label for="symbol-select" class="form-label fw-semibold mb-2 small text-secondary">Символ</label>
                                <select id="symbol-select" name="symbol" class="form-control form-control-sm border-0 bg-light" style="border-radius: 8px; padding: 8px 12px;" required>
                                    <option value="">-- Выберите символ --</option>
                                    @foreach (var symbol in symbols)
                                    {
                                        <option value="@symbol">@symbol</option>
                                    }
                                </select>
                            </div>
                
                            <div class="form-check d-flex align-items-center mb-0 flex-shrink-0">
                                <input class="form-check-input me-2" type="checkbox" id="download-all-checkbox" style="border-radius: 6px;">
                                <label class="form-check-label mb-0 small" for="download-all-checkbox" style="white-space: nowrap;">
                                    <strong>Скачать для всех активных символов (@Model.ActiveSymbols.Count)</strong>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card shadow-sm border-0 mb-1" style="border-radius: 12px; overflow: hidden;">
                <div class="list-group list-group-flush">
                    <div class="list-group-item border-0 p-3">
                        <div class="d-flex gap-3 flex-wrap flex-md-nowrap">
                            <div class="flex-fill">
                                <label for="start-date-input" class="form-label fw-semibold mb-2 small text-secondary">Начальная дата</label>
                                <input type="date" id="start-date-input" name="start-date-input" class="form-control form-control-sm border-0 bg-light" style="border-radius: 8px; padding: 8px 12px;" required />
                            </div>
                            <div class="flex-fill">
                                <label for="end-date-input" class="form-label fw-semibold mb-2 small text-secondary">Конечная дата</label>
                                <input type="date" id="end-date-input" name="end-date-input" class="form-control form-control-sm border-0 bg-light" style="border-radius: 8px; padding: 8px 12px;" required />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card shadow-sm border-0 mb-1" style="border-radius: 12px; overflow: hidden;">
                <div class="list-group list-group-flush">
                    <div class="list-group-item border-0 p-3">
                        <button type="button" id="btn-download" class="btn w-100 border-0 fw-semibold text-white" style="border-radius: 10px; padding: 12px; background-color: #007AFF;">
                            <i class="bi bi-download me-2"></i>Начать скачивание новых архивов
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Правая колонка: Лог в реальном времени -->
    <div class="col-md-8">
        <label class="form-label fw-semibold mb-2 small text-secondary">Лог операций</label>
        <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
            <div id="logContainer" style="height: 300px; overflow-y: auto; background-color: #f5f5f7; padding: 12px; font-family: 'SF Mono', 'Monaco', 'Menlo', monospace; font-size: 13px; line-height: 1.5; color: #1d1d1f;">
                <!-- Сюда JavaScript будет добавлять сообщения -->
            </div>
        </div>
    </div>
</div>

<!-- Раздел для просмотра уже скачанных файлов (пока пустой) -->
<div class="row mt-1">
    <div class="col-12">
        <h4>2. Скачанные архивы</h4>

        @if (Model.ArchivedFiles != null && Model.ArchivedFiles.Any())
        {
            <!-- Добавляем форму вокруг нашей таблицы -->
            <form id="archive-form">
                @Html.AntiForgeryToken() <!-- Токен для защиты -->
                <!-- Добавляем кнопки действий -->
                <div class="mb-3">
                    <button type="button" id="btn-process" class="btn btn-primary">Проверить и распаковать</button>
                    <button type="button" id="btn-delete" class="btn btn-danger">Удалить выбранные</button>
                </div>


                <div class="table-container-scrollable" id="archiveListContainer">

                    <table class="table table-striped table-compact table-hover">
                        <thead>
                            <tr>
                                <th><input type="checkbox" id="select-all-checkbox" /></th> <!-- Чекбокс "Выбрать все" -->
                                <th>Имя файла</th>
                                <th>Символ</th>
                                <th>Дата</th>
                                <th>Размер</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var file in Model.ArchivedFiles)
                            {
                                <tr>
                                    <td><input type="checkbox" class="file-checkbox" name="FileNames" value="@file.FileName" /></td>
                                    <td>@file.FileName</td>
                                    <td>@file.Symbol</td>
                                    <td>@file.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@((file.SizeBytes / 1024.0).ToString("F2")) KB</td>
                                    <td><span class="badge bg-secondary">@file.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </form>
        }
        else
        {
            <p>Скачанных файлов не найдено.</p>
        }

    </div>
</div>

@section Scripts {
    <script>
            $(document).ready(function () {
            // --- ОБЪЯВЛЯЕМ ПЕРЕМЕННЫЕ ДЛЯ ВСЕГО СКРИПТА В ОДНОМ МЕСТЕ ---
            const logContainer = $('#logContainer');
            const token = $('input[name="__RequestVerificationToken"]').val();
            const downloadAllCheckbox = $('#download-all-checkbox');
            const symbolSelect = $('#symbol-select');
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/archiveStatusHub")
                .configureLogging(signalR.LogLevel.Information)
                .build();

            // --- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ---
            function logMessage(message) {
                const time = new Date().toLocaleTimeString();
                logContainer.prepend(`<div>[${time}] ${message}</div>`);
            }

            function syncSelectState() {
                if (downloadAllCheckbox.is(':checked')) {
                    symbolSelect.prop('disabled', true).prop('required', false).val('');
                } else {
                    symbolSelect.prop('disabled', false).prop('required', true);
                }
            }

            // --- НАСТРОЙКА И ЗАПУСК SIGNALR ---
            connection.on("ReceiveStatusUpdate", (message) => {
                logMessage(message);
            });

            async function startSignalR() {
                try {
                    await connection.start();
                    console.log("SignalR Connected with connectionId: " + connection.connectionId);
                    logMessage("<b>SignalR:</b> Соединение установлено.");

                    //await connection.invoke("SubscribeToStatusUpdates");
                } catch (err) {
                    console.error(err);
                    setTimeout(startSignalR, 5000);
                }
            };

            connection.onclose(startSignalR);
            startSignalR(); // Запускаем соединение

            // --- ОБРАБОТЧИКИ СОБЫТИЙ ---

            // 1. Для чекбокса "Скачать для всех"
            downloadAllCheckbox.change(syncSelectState);

            // 2. Для кнопки "Начать скачивание"
            $('#btn-download').click(function () {
                const startDate = $('#start-date-input').val();
                const endDate = $('#end-date-input').val();
                const requestId = crypto.randomUUID();          // Генерируем новый уникальный ID для этой операции
                const connectionId = connection.connectionId;   // Получаем ID текущего SignalR-соединения

                if (!downloadAllCheckbox.is(':checked') && (!symbolSelect.val() || symbolSelect.val() === "")) {
                    alert('Пожалуйста, выберите символ или отметьте "Скачать для всех".');
                    return;
                }
                if (!startDate || !endDate) {
                    alert('Пожалуйста, укажите диапазон дат.');
                    return;
                }
                if (new Date(startDate) > new Date(endDate)) {
                    alert('Начальная дата не может быть позже конечной.');
                    return;
                }
                if (!connectionId) { // Проверяем, что SignalR-соединение уже установлено
                    alert("Соединение с сервером для получения статусов еще не установлено. Пожалуйста, подождите несколько секунд и попробуйте снова.");
                    return;
                }

                logMessage("Отправка запроса на скачивание...");
                const requestData = {
                    symbol: symbolSelect.val(),
                    downloadAll: downloadAllCheckbox.is(':checked'),
                    startDate: startDate,
                    endDate: endDate,
                    requestId: requestId,
                    connectionId: connectionId
                };

                $.ajax({
                    url: '@Url.Action("DownloadArchives", "Archive")',
                    type: 'POST', contentType: 'application/json',
                    headers: { 'RequestVerificationToken': token },
                    data: JSON.stringify(requestData),
                    success: (response) => logMessage(`<b>Сервер ответил:</b> ${response.message}`),
                    error: (xhr) => {
                        console.error('Ошибка:', xhr);
                        logMessage(`<b style="color: red;">Ошибка!</b> ${xhr.responseText}`);
                    }
                });
            });

            // 3. Для таблицы скачанных архивов
            $('#select-all-checkbox').click(function () {
                $('#archiveListContainer .file-checkbox').prop('checked', this.checked);
            });

            $('#btn-process').click(function () {
                const selectedFiles = $('#archiveListContainer .file-checkbox:checked').map(function() { return $(this).val(); }).get();
                const token = $('input[name="__RequestVerificationToken"]').val();
                if (selectedFiles.length === 0) {
                    alert('Пожалуйста, выберите хотя бы один файл для обработки.');
                    return;
                }
                const connectionId = connection.connectionId;
                if (!connectionId) {
                    alert("Соединение с сервером (SignalR) не установлено. Пожалуйста, подождите.");
                    return;
                }
                logMessage(`Отправка запроса на обработку ${selectedFiles.length} файлов...`);
                const requestData = {
                    fileNames: selectedFiles,
                    connectionId: connectionId // <-- ОТПРАВЛЯЕМ ID
                };
                $.ajax({
                    url: '@Url.Action("ProcessArchives", "Archive")', 
                    type: 'POST', 
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': token },
                    data: JSON.stringify(requestData),
                    success: (response) => {
                        logMessage(`<b>Сервер ответил:</b> ${response.message}`);
                        alert(response.message);
                        setTimeout(() => location.reload(), 3000);
                    },
                    error: (xhr) => {
                        logMessage(`<b style="color: red;">Ошибка!</b> ${xhr.responseText}`);
                        alert(`Произошла ошибка: ${xhr.responseText}`);
                    }
                });
            });

            $('#btn-delete').click(function () {
                const selectedFiles = $('#archiveListContainer .file-checkbox:checked').map(function() { return $(this).val(); }).get();
                if (selectedFiles.length === 0) {
                    alert('Пожалуйста, выберите хотя бы один файл для удаления.');
                    return;
                }
                if (!confirm(`Вы уверены, что хотите удалить ${selectedFiles.length} выбранных файлов?`)) {
                    return;
                }
                logMessage(`Отправка запроса на удаление ${selectedFiles.length} файлов...`);
                $.ajax({
                    url: '@Url.Action("DeleteArchives", "Archive")', type: 'POST', contentType: 'application/json',
                    headers: { 'RequestVerificationToken': token }, data: JSON.stringify({ fileNames: selectedFiles }),
                    success: (response) => {
                        logMessage(`<b>Сервер ответил:</b> ${response.message}`);
                        alert(response.message);
                        setTimeout(() => location.reload(), 3000);
                    },
                    error: (xhr) => {
                        logMessage(`<b style="color: red;">Ошибка!</b> ${xhr.responseText}`);
                        alert(`Произошла ошибка: ${xhr.responseText}`);
                    }
                });
            });

            // --- ЗАПУСК ПРИ ЗАГРУЗКЕ ---
            syncSelectState();
            logMessage("Страница готова. Ожидание действий...");
        });

    </script>
}